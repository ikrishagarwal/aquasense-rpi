[Unit]
Description=AquaSense isolated vision worker (simulation only)
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=purifier-vision
Group=purifier-ipc
WorkingDirectory=/opt/aquasense
ExecStart=/opt/aquasense/.venv/bin/python -m purifier.vision.worker --simulation --socket /run/purifier-vision/worker.sock
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0007
RuntimeDirectory=purifier-vision
RuntimeDirectoryMode=0750
StateDirectory=purifier-vision
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/purifier-vision /run/purifier-vision
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60

[Install]
WantedBy=multi-user.target
